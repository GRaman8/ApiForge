<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- cdk synth stages the Docker build context here; keep those copied sources out of our build. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);cdk.out/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" Version="2.258.0" />
    <PackageReference Include="Constructs" Version="10.6.0" />
  </ItemGroup>

</Project>
